---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Clean Space - Premium UI Boilerplate">
  <!-- Hero Section -->
  <section class="relative pt-32 pb-20 sm:pt-40 sm:pb-24 overflow-hidden">
    <div class="container-custom relative z-10 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-sm text-zinc-300 mb-8 backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-brand-accent animate-pulse"></span>
        v2.0 Boilerplate
      </div>
      
      <h1 class="text-5xl sm:text-7xl font-bold tracking-tight text-white mb-6">
        Minimum <br class="hidden sm:block" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-accent to-primary">
          Viable Premium.
        </span>
      </h1>
      
      <p class="mt-6 text-lg sm:text-xl text-zinc-400 max-w-2xl mx-auto font-light leading-relaxed">
        A relentlessly clean, beautifully crafted starting point for your next Astro project. Stop fighting the defaults and start creating.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/docs" class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-white text-zinc-950 font-semibold shadow-[0_0_40px_-10px_rgba(255,255,255,0.3)] hover:scale-105 transition-all duration-300">
          Start Building
        </a>
        <a href="https://github.com/bpolitiadis/astro-leadwave-boilerplate" class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-white/5 text-white border border-white/10 backdrop-blur-md hover:bg-white/10 transition-all duration-300 flex items-center justify-center gap-2">
          <span>View Source</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Bento Grid Showcase Section -->
  <section class="section-padding">
    <div class="container-custom">
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-[minmax(300px,auto)]">
        
        <!-- Large Card: Main Dashboard Preview -->
        <div class="md:col-span-2 md:row-span-2 rounded-3xl bg-zinc-900/40 border border-white/5 overflow-hidden flex flex-col relative group backdrop-blur-md">
          <div class="absolute inset-0 bg-gradient-to-br from-brand-accent/5 to-transparent pointer-events-none"></div>
          <div class="p-8 flex-grow flex flex-col justify-end">
            <div class="space-y-4">
              <div class="h-10 w-10 rounded-xl bg-brand-accent/20 text-brand-accent flex items-center justify-center border border-brand-accent/30">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
              </div>
              <h3 class="text-2xl font-semibold text-zinc-100">Revenue Metrics</h3>
              <p class="text-zinc-400 max-w-sm">A placeholder for data visualization or a massive feature highlight.</p>
            </div>
          </div>
          <!-- Abstract "Chart" element -->
          <div class="h-48 w-full mt-4 flex items-end px-8 gap-3 opacity-60 group-hover:opacity-100 transition-opacity duration-500">
            <div class="w-full bg-brand-accent/20 hover:bg-brand-accent/40 transition-colors border-t border-brand-accent/30 rounded-t-sm h-[40%]"></div>
            <div class="w-full bg-brand-accent/20 hover:bg-brand-accent/40 transition-colors border-t border-brand-accent/30 rounded-t-sm h-[60%]"></div>
            <div class="w-full bg-brand-accent/20 hover:bg-brand-accent/40 transition-colors border-t border-brand-accent/30 rounded-t-sm h-[30%]"></div>
            <div class="w-full bg-brand-accent/20 hover:bg-brand-accent/40 transition-colors border-t border-brand-accent/30 rounded-t-sm h-[80%]"></div>
            <div class="w-full bg-brand-accent/40 hover:bg-brand-accent/60 transition-colors border-t border-brand-accent/50 rounded-t-sm h-[100%] shadow-[0_0_20px_hsl(var(--brand-accent)/0.3)]"></div>
          </div>
        </div>

        <!-- Medium Card: Activity -->
        <div class="rounded-3xl bg-zinc-900/40 border border-white/5 p-8 flex flex-col justify-between backdrop-blur-md hover:bg-zinc-900/60 transition-colors">
          <div class="h-10 w-10 rounded-xl bg-primary/20 text-primary flex items-center justify-center border border-primary/30 mb-6">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <div>
            <h3 class="text-xl font-semibold text-zinc-100 mb-2">Real-time Activity</h3>
            <p class="text-sm text-zinc-400">Perfect spot for quick stats or recent notifications.</p>
          </div>
          <!-- Mock list -->
          <div class="mt-6 space-y-4">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-zinc-800 border border-white/10 flex items-center justify-center text-xs text-zinc-400">JD</div>
                <div class="h-4 w-24 bg-white/5 rounded"></div>
              </div>
              <div class="h-4 w-12 bg-white/5 rounded"></div>
            </div>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-zinc-800 border border-white/10 flex items-center justify-center text-xs text-zinc-400">AS</div>
                <div class="h-4 w-20 bg-white/5 rounded"></div>
              </div>
              <div class="h-4 w-10 bg-white/5 rounded"></div>
            </div>
          </div>
        </div>

        <!-- Medium Card: Integration -->
        <div class="rounded-3xl bg-zinc-900/40 border border-white/5 p-8 relative overflow-hidden backdrop-blur-md group">
          <div class="absolute -right-10 -top-10 w-40 h-40 bg-brand-accent/10 blur-[50px] rounded-full group-hover:bg-brand-accent/20 transition-colors"></div>
          <div class="relative z-10 flex flex-col h-full justify-between">
            <div class="h-10 w-10 rounded-xl bg-brand-accent/20 text-brand-accent flex items-center justify-center border border-brand-accent/30 mb-6">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-zinc-100 mb-2">Developer First</h3>
              <p class="text-sm text-zinc-400">Tailwind configured, Astro optimized. Ready for your logic.</p>
            </div>
          </div>
        </div>
        
        <!-- Wide Card: Component Library -->
        <div class="md:col-span-3 rounded-3xl bg-zinc-900/40 border border-white/5 p-8 flex flex-col md:flex-row items-center gap-8 backdrop-blur-md">
           <div class="flex-1">
             <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs text-zinc-300 mb-4">
               Ready to use
             </div>
             <h3 class="text-2xl font-semibold text-zinc-100 mb-3">Copy. Paste. Ship.</h3>
             <p class="text-zinc-400">Grab these beautifully styled, accessible components directly into your application without breaking a sweat.</p>
           </div>
           <div class="flex-1 w-full bg-black/20 rounded-2xl border border-white/5 p-6 flex flex-wrap gap-4 items-center justify-center">
             <button class="px-4 py-2 bg-white text-black text-sm font-medium rounded-md hover:bg-zinc-200 transition-colors">Primary</button>
             <button class="px-4 py-2 bg-white/10 border border-white/10 text-white text-sm font-medium rounded-md hover:bg-white/20 transition-colors">Secondary</button>
             <div class="flex items-center gap-2 px-4 py-2 border border-white/10 rounded-md bg-black/40 text-sm text-zinc-400 w-full sm:w-auto mt-2 sm:mt-0">
               <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
               <span class="opacity-50">Search everything...</span>
               <kbd class="ml-4 font-sans px-1.5 py-0.5 rounded-sm bg-white/10 text-[10px]">&uarr; K</kbd>
             </div>
           </div>
        </div>

      </div>
    </div>
  </section>
</Layout>
