---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allDocs = await Astro.glob('../../../docs/*.md');
  
  return allDocs.map(doc => {
    const filename = doc.file.split('/').pop() || '';
    const slug = filename.replace('.md', '');
    
    return {
      params: { slug },
      props: { doc }
    };
  });
}

const { doc } = Astro.props;

if (!doc) {
  return Astro.redirect('/404');
}

const DocContent = doc.Content;
const filePath = doc.file;

function getTitleFromFilename(path: string) {
  const filename = path.split('/').pop() || '';
  const name = filename.replace('.md', '');
  return name.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
}

const title = getTitleFromFilename(filePath);
---

<Layout title={`${title} - Documentation`}>
  <section class="pt-32 pb-20 relative min-h-screen">
    <div class="max-w-3xl mx-auto px-6 relative z-10">
      <div class="mb-8">
        <a href="/docs" class="text-sm text-brand-accent hover:text-brand-accent/80 transition-colors inline-flex items-center gap-2 mb-6 cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path></svg>
          Back to Docs
        </a>
        <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-white mb-4">{title}</h1>
      </div>

      <article class="prose prose-invert max-w-none prose-headings:font-bold prose-a:text-brand-accent prose-p:text-zinc-300 prose-li:text-zinc-300 bg-zinc-900/40 p-8 rounded-3xl border border-white/5 backdrop-blur-md">
        <DocContent />
      </article>
    </div>
  </section>
</Layout>
