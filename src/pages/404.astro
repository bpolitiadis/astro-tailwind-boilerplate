---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | 404">
  <section class="mx-auto max-w-3xl px-6 py-20 text-center">
    <p class="text-sm font-semibold text-blue-600">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Page not found</h1>
    <p class="mt-4 text-base text-gray-600">Sorry, we couldn’t find the page you’re looking for.</p>
    <div class="mt-8 flex items-center justify-center gap-3">
      <a href="/" class="inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2">Go back home</a>
      <a href="/contact" class="inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">Contact support</a>
    </div>
  </section>
</Layout>


