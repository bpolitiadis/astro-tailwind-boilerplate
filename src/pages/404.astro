---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | 404">
  <section class="mx-auto max-w-3xl px-6 py-20 text-center">
    <p class="text-sm font-semibold text-primary">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">Page not found</h1>
    <p class="mt-4 text-base text-muted-foreground">Sorry, we couldn’t find the page you’re looking for.</p>
    <div class="mt-8 flex items-center justify-center gap-3">
      <a href="/" class="inline-flex items-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background">Go back home</a>
      <a href="/contact" class="inline-flex items-center rounded-md border border-input bg-background px-4 py-2 text-sm font-medium text-foreground hover:bg-accent hover:text-accent-foreground">Contact support</a>
    </div>
  </section>
</Layout>


