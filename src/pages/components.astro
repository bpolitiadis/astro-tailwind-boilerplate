---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Components - Clean Space Boilerplate">
  <section class="pt-32 pb-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <div class="mb-12">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-white mb-4">Components</h1>
        <p class="text-lg text-zinc-400 max-w-2xl font-light">
          A showcase of the premium minimalistic components available in this boilerplate. Pure Tailwind and Astro.
        </p>
      </div>

      <div class="space-y-16">
        <!-- Buttons Section -->
        <div class="space-y-6">
          <h2 class="text-xl font-semibold text-zinc-100 flex items-center gap-3">
            <span class="w-8 h-px bg-white/20"></span>
            Buttons
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="rounded-2xl border border-white/5 bg-zinc-900/40 p-8 flex items-center justify-center backdrop-blur-md hover:bg-zinc-900/60 transition-colors">
              <button class="px-6 py-2.5 bg-white text-zinc-950 font-medium rounded-lg shadow-lg hover:shadow-white/20 transition-all active:scale-95">Primary</button>
            </div>
            <div class="rounded-2xl border border-white/5 bg-zinc-900/40 p-8 flex items-center justify-center backdrop-blur-md hover:bg-zinc-900/60 transition-colors">
              <button class="px-6 py-2.5 bg-white/10 text-white font-medium rounded-lg hover:bg-white/20 transition-all active:scale-95">Secondary</button>
            </div>
            <div class="rounded-2xl border border-white/5 bg-zinc-900/40 p-8 flex items-center justify-center backdrop-blur-md hover:bg-zinc-900/60 transition-colors">
              <button class="px-6 py-2.5 border border-white/10 text-zinc-300 font-medium rounded-lg hover:bg-white/5 hover:text-white transition-all active:scale-95">Outline</button>
            </div>
          </div>
        </div>

        <!-- Cards Section -->
        <div class="space-y-6">
          <h2 class="text-xl font-semibold text-zinc-100 flex items-center gap-3">
            <span class="w-8 h-px bg-white/20"></span>
            Cards
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="rounded-2xl border border-white/5 bg-zinc-900/40 p-8 backdrop-blur-md group hover:bg-zinc-900/60 transition-colors">
             <div class="h-10 w-10 rounded-xl bg-violet-500/20 text-violet-400 flex items-center justify-center border border-violet-500/30 mb-6 group-hover:scale-110 transition-transform">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
             </div>
             <h3 class="text-lg font-semibold text-zinc-100 mb-2">Feature Card</h3>
             <p class="text-zinc-400 text-sm">Glassmorphic background, subtle border, smooth hover transitions.</p>
            </div>

            <div class="relative rounded-2xl border border-white/5 bg-zinc-900/40 p-8 backdrop-blur-md overflow-hidden group">
              <div class="absolute right-0 top-0 w-32 h-32 bg-indigo-500/10 blur-[40px] rounded-full group-hover:bg-indigo-500/20 transition-colors"></div>
              <div class="relative z-10 flex flex-col justify-between h-full space-y-4">
                <div>
                  <h3 class="text-lg font-semibold text-zinc-100 mb-2">Metric Card</h3>
                  <div class="text-4xl font-light text-white">$124,500</div>
                </div>
                <div class="flex items-center gap-2 text-sm text-emerald-400 mt-4">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                  <span>+14.5% from last month</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Inputs Section -->
        <div class="space-y-6">
          <h2 class="text-xl font-semibold text-zinc-100 flex items-center gap-3">
            <span class="w-8 h-px bg-white/20"></span>
            Inputs
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="rounded-2xl border border-white/5 bg-zinc-900/40 p-8 backdrop-blur-md">
              <label class="block text-sm font-medium text-zinc-400 mb-2">Standard Input</label>
              <input type="text" placeholder="user@example.com" class="w-full bg-black/40 border border-white/10 rounded-lg px-4 py-2.5 text-zinc-100 placeholder:text-zinc-600 focus:outline-none focus:ring-2 focus:ring-violet-500/50 focus:border-violet-500/50 transition-all" />
            </div>
            
            <div class="rounded-2xl border border-white/5 bg-zinc-900/40 p-8 backdrop-blur-md md:col-span-2">
              <label class="block text-sm font-medium text-zinc-400 mb-2">Search Input with Command</label>
              <div class="relative flex items-center w-full">
                <svg class="absolute left-3 w-5 h-5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                <input type="text" placeholder="Search commands, docs..." class="w-full bg-black/40 border border-white/10 rounded-lg pl-10 pr-16 py-3 text-zinc-100 placeholder:text-zinc-600 focus:outline-none focus:ring-2 focus:ring-violet-500/50 transition-all" />
                <div class="absolute right-3 flex items-center gap-1">
                  <kbd class="font-sans px-1.5 py-0.5 rounded bg-white/10 text-[10px] text-zinc-400 border border-white/5">⌘</kbd>
                  <kbd class="font-sans px-1.5 py-0.5 rounded bg-white/10 text-[10px] text-zinc-400 border border-white/5">K</kbd>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
