---
// Accessibility skip links — allow keyboard users to jump past the header
// directly to main content, navigation, or footer.
// These are invisible until focused (Tab key), then slide into view.
---

<div class="skip-links" data-testid="skip-links">
  <a href="#main-content" class="skip-link" data-testid="skip-to-main">
    Skip to main content
  </a>
  <a href="#navigation" class="skip-link" data-testid="skip-to-nav">
    Skip to navigation
  </a>
  <a href="#footer" class="skip-link" data-testid="skip-to-footer">
    Skip to footer
  </a>
</div>

<style>
  .skip-links {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1000;
  }

  .skip-link {
    position: absolute;
    top: -100px;
    left: 0;
    background: #000;
    color: #fff;
    padding: 8px 16px;
    text-decoration: none;
    font-weight: 600;
    border-radius: 0 0 4px 0;
    transition: top 0.2s ease;
    z-index: 1001;
  }

  .skip-link:focus {
    top: 0;
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .skip-link:hover {
    background: #333;
  }
</style>
