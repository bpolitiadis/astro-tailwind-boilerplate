---
import { cva, type VariantProps } from 'class-variance-authority';
import type { HTMLAttributes } from 'astro/types';
import { cn } from '@/lib/utils';

const buttonVariants = cva(
  'inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50',
  {
    variants: {
      variant: {
        default: 'bg-primary text-primary-foreground hover:bg-primary/90 shadow-sm',
        destructive: 'bg-destructive text-destructive-foreground hover:bg-destructive/90 shadow-sm',
        outline:
          'border border-input bg-background text-foreground hover:bg-accent hover:text-accent-foreground',
        secondary: 'bg-secondary text-secondary-foreground hover:bg-secondary/80 shadow-sm',
        ghost: 'text-foreground hover:bg-accent hover:text-accent-foreground',
        link: 'text-primary underline-offset-4 hover:underline'
      },
      size: {
        default: 'h-10 px-4 py-2',
        sm: 'h-9 rounded-md px-3',
        lg: 'h-11 rounded-md px-8',
        icon: 'size-10'
      }
    },
    defaultVariants: {
      variant: 'default',
      size: 'default'
    }
  }
);

type ButtonVariantProps = VariantProps<typeof buttonVariants>;

type SharedProps = ButtonVariantProps & {
  class?: string;
};

type ButtonAsButtonProps = SharedProps &
  Omit<HTMLAttributes<'button'>, 'class'> & {
    as?: 'button';
  };

type ButtonAsAnchorProps = SharedProps &
  Omit<HTMLAttributes<'a'>, 'class'> & {
    as: 'a';
  };

export type Props = ButtonAsButtonProps | ButtonAsAnchorProps;

const { as = 'button', class: className, variant, size, ...rest } = Astro.props as Props;

const classes = cn(buttonVariants({ variant, size }), className);
---

{as === 'a' ? (
  <a
    {...(rest as Omit<ButtonAsAnchorProps, 'as' | 'class' | 'size' | 'variant'>)}
    class={classes}
  >
    <slot />
  </a>
) : (
  <button
    {...(rest as Omit<ButtonAsButtonProps, 'as' | 'class' | 'size' | 'variant'>)}
    class={classes}
    type={(rest as ButtonAsButtonProps).type ?? 'button'}
    disabled={(rest as ButtonAsButtonProps).disabled ?? false}
  >
    <slot />
  </button>
)}
